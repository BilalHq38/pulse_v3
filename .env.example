MEMORY_BUDGET_KNOWLEDGE=800
MEMORY_BUDGET_PRODUCTS=400
MEMORY_BUDGET_STATE=250
MEMORY_BUDGET_SYSTEM=350
MEMORY_SHORT_TERM_TTL_SECONDS=1800
MEMORY_SHORT_TERM_MAX_MESSAGES=20

# Billing and campaign tuning
ONBOARDING_REMINDER_DELAY_MINUTES=60
BILLING_CACHE_TTL_SECONDS=60
USAGE_CACHE_TTL_SECONDS=60
