# AI runtime tuning
AI_SERVICE_TIMEOUT_SECONDS=60
AI_SERVICE_RETRY_ATTEMPTS=3
AI_SERVICE_RETRY_BACKOFF_SECONDS=0.5
AI_SERVICE_CIRCUIT_BREAKER_FAILURES=5
AI_SERVICE_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
AI_ENABLE_RULE_BASED_RECOVERY=true
AI_CONFIDENCE_THRESHOLD=0.25
GEMINI_INPUT_TOKEN_BUDGET=12000
AI_RESPONSE_RECENT_MESSAGE_LIMIT=3
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_CACHE_MAX_ITEMS=2000
RAG_CATALOG_CACHE_TTL_SECONDS=300
MEMORY_BUDGET_CONVERSATION=2000
