# Pulse Engine environment template.
# Copy to .env and replace every change-me value before production use.

ENVIRONMENT=development
NODE_ENV=development
DEMO_MODE=false
STRIPE_OPTIONAL=false
STRIPE_ENABLED=auto
TRIAL_PERIOD_DAYS=30

# Public URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_DEMO_MODE=false
GATEWAY_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
SUPER_ADMIN_HOST_PORT=8011

# Database
POSTGRES_USER=pulse_engine_app
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=pulse_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
# For AWS RDS or any managed PostgreSQL requiring TLS, set POSTGRES_SSLMODE=require.
POSTGRES_SSLMODE=
POSTGRES_CONNECT_TIMEOUT=10
DATABASE_URL=postgresql://pulse_engine_app:change-me-postgres-password@postgres:5432/pulse_engine
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_COMMAND_TIMEOUT_SECONDS=60
DB_STARTUP_RETRIES=10
DB_STARTUP_RETRY_BACKOFF_SECONDS=2
# Identity service SQLAlchemy pool knobs
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis and background jobs
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
BACKGROUND_QUEUE_URL=redis://redis:6379/3
QUEUE_REDIS_URL=
BACKGROUND_QUEUE_ENABLED=true
BACKGROUND_QUEUE_MAX_RETRIES=5
BACKGROUND_QUEUE_VISIBILITY_TIMEOUT=300
BACKGROUND_QUEUE_JOB_TIMEOUT_SECONDS=600
BACKGROUND_QUEUE_JOB_TTL_SECONDS=86400

# Security
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
INTERNAL_SERVICE_SECRET=change-me-to-a-random-24-plus-character-secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DEFAULT_TENANT_ID=demo_tenant
DEMO_TENANT_ID=demo_tenant
DEFAULT_TENANT_API_KEY=change-me-default-tenant-api-key
DEFAULT_TENANT_SALT=change-me-default-tenant-salt
TENANT_API_KEYS=demo_tenant:change-me-default-tenant-api-key
TENANT_SALTS=demo_tenant:change-me-default-tenant-salt
IDENTITY_ADMIN_EMAIL=admin@example.com
IDENTITY_ADMIN_PASSWORD=change-me-identity-admin-password
TENANT_RATE_LIMIT_PER_MINUTE=1000

# Internal service URLs for Docker Compose networking
AUTH_SERVICE_URL=http://auth:8001
USER_SERVICE_URL=http://user:8002
CUSTOMER_SERVICE_URL=http://customer:8003
LEAD_SERVICE_URL=http://lead:8004
EMAIL_CAMPAIGN_SERVICE_URL=http://email-campaign:8013
AI_SERVICE_URL=http://ai:8005
ORCHESTRATOR_SERVICE_URL=http://agent-orchestrator:8009
ANALYTICS_SERVICE_URL=http://analytics:8006
DATA_PIPELINE_SERVICE_URL=http://data-pipeline:8012
PRODUCT_SERVICE_URL=http://product:8007
NOTIFICATION_SERVICE_URL=http://notification:8008
IDENTITY_SERVICE_URL=http://identity:8010
IDENTITY_REALTIME_RELAY_TIMEOUT_SECONDS=5
SUPER_ADMIN_SERVICE_URL=http://super-admin:8011

# AI providers
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash
AI_API_ENDPOINT=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_MODEL_VERSION=current
AI_INPUT_TOKEN_BUDGET=12000
ORCHESTRATOR_REQUEST_TIMEOUT_SECONDS=60
AI_API_CALL_TIMEOUT_SECONDS=15
AI_FALLBACK_TIMEOUT_SECONDS=60
OUTBOUND_RETRY_BASE_DELAY_SECONDS=1
AI_RESPONSE_COOLDOWN_SECONDS=300
DEDUP_CACHE_TTL_SECONDS=300
AI_MODEL_HEALTH_CACHE_TTL_SECONDS=30
AI_ENABLE_PROVIDER_FALLBACK=true
AI_MAX_PROVIDER_ATTEMPTS=3
AI_RESPONSE_TEMPERATURE_BASE=0.72
AI_RESPONSE_TEMPERATURE_MIN=0.55
AI_RESPONSE_TEMPERATURE_MAX=1.05
AI_RESPONSE_TEMPERATURE_JITTER_STEPS=6
AI_RESPONSE_TEMPERATURE_PRODUCT_DELTA=0.08
AI_RESPONSE_TEMPERATURE_NEGATIVE_DELTA=-0.10
AI_RESPONSE_TEMPERATURE_REPETITION_DELTA=0.06
AI_RESPONSE_RETRY_TEMPERATURE_DELTA=0.14
AI_RESPONSE_RETRY_TEMPERATURE_MAX=1.1
AI_SENTIMENT_FALLBACK_PROVIDER=gemini
AI_SENTIMENT_FALLBACK_MODEL=
AI_SENTIMENT_FALLBACK_TEMPERATURE=0.25
AI_SENTIMENT_FALLBACK_MAX_TOKENS=1024
AI_EMBEDDING_PROVIDER=
AI_ENABLE_EMBEDDING_PROVIDER_FALLBACK=true
AI_EMBEDDING_UNSUPPORTED_COOLDOWN_SECONDS=900
ALLOW_LOCAL_AI_FALLBACK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-exp-03-07
REQUIRE_MCP=false

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Webhooks and channels
META_WEBHOOK_SECRET=change-me-meta-webhook-secret
META_CREDENTIALS_ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_SECRET=change-me-meta-webhook-secret
FACEBOOK_WEBHOOK_SECRET=change-me-facebook-webhook-secret
INSTAGRAM_WEBHOOK_SECRET=change-me-instagram-webhook-secret
WEB_CHAT_WEBHOOK_SECRET=change-me-web-chat-secret
EXTERNAL_WEBHOOK_SECRET=change-me-external-webhook-secret
ALLOW_LEGACY_EXTERNAL_WEBHOOK_QUERY_TOKEN=false
EXTERNAL_WEBHOOK_TOKEN=
WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_BASE=https://graph.facebook.com
META_WEBHOOK_IP_ALLOWLIST=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_MODE=bridge
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
WHATSAPP_BRIDGE_SECRET=change-me-whatsapp-bridge-secret
WHATSAPP_BRIDGE_HOST_PORT=3001
BRIDGE_PORT=3001
PYTHON_BACKEND=http://gateway:8000
WHATSAPP_WEBHOOK_PATH=/api/webhook/meta/whatsapp
BRIDGE_COMPANY_ID=demo_tenant
# ISO 3166-1 alpha-2 default region for local numbers without + (e.g. PK, US, GB, AE, IN). Best practice: store E.164 in the DB; only needed for legacy local formats.
WHATSAPP_DEFAULT_COUNTRY=
UPLOAD_STORAGE_DIR=/app/uploads
MEDIA_STORAGE_BACKEND=local
MEDIA_S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_SERVER_SIDE_ENCRYPTION=AES256
MEDIA_S3_PRESIGNED_URL_TTL_SECONDS=300
AWS_REGION=
# Bridge only: digits without +, for session display and forwarded webhook metadata.
MY_WHATSAPP_NUMBER=

# Demo bootstrap
DEMO_ACCOUNTS_PASSWORD=
DEMO_USER_EMAIL=
DEMO_SUPERADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_COMPANY_ID=platform

# Gateway limits and CORS
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GATEWAY_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
GATEWAY_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-Request-ID,X-Correlation-ID,X-Trace-ID,X-Span-ID,X-Parent-Span-ID,traceparent,tracestate,baggage
SOCKET_RATE_LIMIT_REQUESTS=20
SOCKET_RATE_LIMIT_WINDOW_SECONDS=60

# Additional compatibility aliases and advanced tuning
APP_ENV=development
BACKEND_BASE_URL=http://localhost:8000
PULSE_API=http://localhost:8000/api
REACT_APP_DEFAULT_TENANT_ID=demo_tenant
REACT_APP_SOCKET_URL=http://localhost:3000
REACT_APP_WIDGET_KEY=
SERVICE_NAME=
PORT=
LOG_LEVEL=INFO
ALLOWED_ORIGINS=
CORS_ORIGINS=

# Database compatibility aliases
POSTGRES_URL=
POSTGRES_DSN=
POSTGRES_ECHO=false
DATABASE_SSLMODE=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=
PGCONNECT_TIMEOUT=
DB_PROVIDER=postgres
DB_SCHEMA=public
PG_EMBEDDED_ENABLED=false

# Background queue extras
BACKGROUND_QUEUE_STREAM_PREFIX=pulse_engine:bg_jobs
BACKGROUND_QUEUE_CONSUMER_PREFIX=worker
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
SERVICE_CPU_LIMIT=1.0
SERVICE_MEMORY_LIMIT=1024M
BACKGROUND_QUEUE_WORKER_CONCURRENCY=4

# Security compatibility and TTLs
SECRET_KEY=change-me-shared-secret-key
APP_ENCRYPTION_KEY=change-me-app-encryption-key
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH_STATE_TTL_MINUTES=10
OAUTH_SESSION_TTL_DAYS=30
INVITATION_TTL_HOURS=72
PENDING_SIGNUP_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_MINUTES=1440
ACCOUNT_DELETION_TTL_MINUTES=15
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_LOCK_MINUTES=15
VERIFICATION_RESEND_MAX_ATTEMPTS=5
TOKEN_BLACKLIST_TTL_SECONDS=604800
ALLOW_INSECURE_DB_ROLE=false
IDENTITY_PUBLIC_TENANT=public_unification
IDENTITY_SELF_SERVICE_MODE=false
PUBLIC_UNIFICATION_TENANT_SALT=
PUBLIC_UNIFICATION_TENANT_SALT_SEED=
